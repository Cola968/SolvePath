{
  "name": "solvepath",
  "version": "0.5.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:export": "expo export --platform android",
    "server:dev": "tsx watch server/src/index.ts",
    "server:start": "tsx server/src/index.ts",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "server:lint": "eslint server --no-ignore",
    "server:test": "vitest run server",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "57.0.19",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-text-extractor": "^2.0.0",
    "fastify": "^5.12.5",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-purchases": "10.10.2",
    "react-native-purchases-ui": "10.10.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "zod": "^4.0.0",
    "zustand": "^5.0.0",
    "expo-image-manipulator": "~57.0.20"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^10.11.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.19.0"
}
