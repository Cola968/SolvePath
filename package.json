    "test": "vitest run",
    "build:export": "expo export --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.0",
    "expo-constants": "~18.2.0",
    "expo-linking": "~9.0.0",
    "expo-router": "~7.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.19.0"
