# Server only. Use an OpenAI-compatible chat/completions endpoint with image support.
LLM_API_KEY=replace-with-server-secret
LLM_MODEL=your-vision-capable-model
LLM_BASE_URL=https://your-provider.example/v1

# Recommended quality mode: a second model pass verifies and may repair the analysis.
LLM_VERIFY_ANALYSIS=true
LLM_TIMEOUT_MS=25000

# Server
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=false
NODE_ENV=development

# Mobile public configuration: backend URL only, never an API key.
EXPO_PUBLIC_SOLVEPATH_API_URL=http://10.0.2.2:3000
