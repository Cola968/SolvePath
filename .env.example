# Optional cloud analysis only. The mobile app defaults to local analysis and needs no LLM key.
# Configure these only if an OpenAI-compatible cloud provider is intentionally enabled.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_VERIFY_ANALYSIS=true
LLM_TIMEOUT_MS=18000

# Server
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=120
FREE_ANALYSES_PER_DAY=3
NODE_ENV=development

# Server-only RevenueCat key used to verify Pro before AI requests.
# Never expose this key through EXPO_PUBLIC_*.
REVENUECAT_SECRET_KEY=replace-with-server-secret
REVENUECAT_ENTITLEMENT_ID=pro

# Mobile public configuration: backend URL only, never an LLM or RevenueCat secret key.
# Leave empty for the zero-cost local-first release.
EXPO_PUBLIC_SOLVEPATH_API_URL=

# RevenueCat public SDK keys. These are intentionally client-visible SDK keys, not secret keys.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_replace_me
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_replace_me
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
